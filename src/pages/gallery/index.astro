---
import Layout from '../../layouts/Layout.astro';
import BikeCard from '../../components/BikeCard.astro';
import { getCollection } from 'astro:content';

const bikes = (await getCollection('bikes')).sort((a, b) => b.data.year - a.data.year);
---

<Layout title="Gallery" description="Every bike built by Signal Cycles, 2007–2018.">
  <section class="hero wrap">
    <h1>Gallery</h1>
    <p>
      These are just a handful of the bikes that Signal produced. Each has a small gallery of
      photos and a short description of the project.
    </p>
  </section>

  <div class="wrap">
    <div class="section-head">
      <h2>All bikes</h2>
    </div>
    <div class="bike-grid">
      {
        bikes.map((bike, index) => (
          <BikeCard
            slug={bike.id}
            name={bike.data.name}
            year={bike.data.year}
            type={bike.data.type}
            coverImage={bike.data.coverImage}
            index={index}
          />
        ))
      }
    </div>
  </div>
</Layout>
