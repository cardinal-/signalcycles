---
import { Image } from 'astro:assets';

interface Props {
  slug: string;
  name: string;
  year: number;
  type: string;
  coverImage: ImageMetadata;
  index?: number;
}

const { slug, name, year, type, coverImage, index = 0 } = Astro.props;
---

<a class="bike-card" href={`/gallery/${slug}`}>
  <div class="thumb">
    <span class="num">{String(index + 1).padStart(2, '0')}</span>
    <Image src={coverImage} alt={name} width={600} height={450} />
  </div>
  <div class="meta">
    <h3>{name}</h3>
    <p class="sub">{year} &middot; {type}</p>
  </div>
</a>
